{
  "name": "browser-use",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Chrome extension + MCP bridge for browser automation",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run build:bridge && node --test tests/*.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:extension": "npm run build --workspace browser-use-extension",
    "build:bridge": "npm run build --workspace browser-use-mcp",
    "jev": "node scripts/jev/cli.mjs",
    "demo": "node scripts/jev/demo.mjs",
    "lab": "node scripts/jev/lab.mjs",
    "browser:isolated": "node scripts/jev/isolated-browser.mjs",
    "s1:fixtures": "node scripts/jev/s1-fixtures.mjs",
    "test:s1:browser": "node tests/e2e/jev-s1.mjs",
    "test:task:mechanical": "node tests/e2e/task-complex.mjs"
  }
}
